ENV=local
LOG_LEVEL=INFO

# Base URL (for constructing webhook urls etc. optional)
PUBLIC_BASE_URL=

# LINE Messaging API (Log bot)
LINE_LOG_CHANNEL_SECRET=
LINE_LOG_CHANNEL_ACCESS_TOKEN=

# LINE Messaging API (Secretary bot)
LINE_SECRETARY_CHANNEL_SECRET=
LINE_SECRETARY_CHANNEL_ACCESS_TOKEN=

# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=Conversations!A:Z

# Service Account JSON (recommended on Render: set as a single env var)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Claude (Anthropic)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# Secretary summary behavior (optional)
SUMMARY_LIMIT=100
SUMMARY_EXTRA_INSTRUCTION=
